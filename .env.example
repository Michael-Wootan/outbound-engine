# Copy to .env for local runs (never commit .env). In GitHub Actions,
# set these under Settings -> Secrets and variables -> Actions.

# --- Secrets ---
APOLLO_API_KEY=your-apollo-api-key
ANTHROPIC_API_KEY=sk-ant-your-key-here
OUTREACH_SMTP_HOST=smtp.example.com
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USER=alex@outreach.acmesupply.example
OUTREACH_SMTP_PASS=your-smtp-app-password
OUTREACH_FROM_EMAIL=alex@outreach.acmesupply.example

# Second mailbox you own: receives the daily summary and plays the reply side of the warmup
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_NOTIFY=you@example.com

# --- Configuration (optional) ---
SENDER_NAME=Alex Morgan
CLAUDE_MODEL=claude-haiku-4-5-20251001
# CONFIG_DIR=./config
# STATE_DIR=./state
