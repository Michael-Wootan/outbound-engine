{
  "name": "outbound-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Daily cold outbound: Apollo search and credit-capped email reveal, Claude-personalized copy, staggered sends, dedupe, dry-run mode and a 21-day domain warmup ramp.",
  "main": "src/cold-email-outreach.js",
  "engines": { "node": ">=20" },
  "scripts": {
